<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.filePathStem }}">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <main class="page">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <a href="https://prabhas.io">{{ site.name }}</a>
  </footer>
</body>
</html>
